@code {

    private List<Producto> productos = new();

    private List<CategoriaModel> categorias = new();

    private Producto productoForm = new();

    private bool cargando = true;

    private bool mostrarFormulario = false;

    private bool productoEditando = false;

    private string textoBusqueda = string.Empty;

    private string error = string.Empty;

    private CancellationTokenSource? busquedaCancellation;


    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }


    private async Task CargarDatos()
    {
        try
        {
            cargando = true;
            error = string.Empty;

            productos =
                await ProductoService.ObtenerProductos();

            categorias =
                await CategoriaService.ObtenerCategorias();
        }
        catch (Exception ex)
        {
            error =
                $"Error al cargar los productos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    // BÚSQUEDA AUTOMÁTICA
    private async Task BuscarMientrasEscribe(ChangeEventArgs e)
    {
        textoBusqueda = e.Value?.ToString() ?? string.Empty;

        busquedaCancellation?.Cancel();
        busquedaCancellation?.Dispose();

        busquedaCancellation =
            new CancellationTokenSource();

        try
        {
            await Task.Delay(
                300,
                busquedaCancellation.Token);

            error = string.Empty;

            if (string.IsNullOrWhiteSpace(textoBusqueda))
            {
                productos =
                    await ProductoService.ObtenerProductos();

                return;
            }

            productos =
                await ProductoService.Buscar(
                    textoBusqueda.Trim());

        }
        catch (TaskCanceledException)
        {
            // El usuario siguió escribiendo.
        }
        catch (Exception ex)
        {
            error =
                $"Error al buscar: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }


    // LIMPIAR BÚSQUEDA
    private async Task LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;

        error = string.Empty;

        productos =
            await ProductoService.ObtenerProductos();
    }


    private void NuevoProducto()
    {
        productoEditando = false;

        productoForm = new Producto
        {
            activo = true,
            tarifa_iva = 15
        };

        mostrarFormulario = true;
    }


    private void EditarProducto(Producto producto)
    {
        productoEditando = true;

        productoForm = new Producto
        {
            id_producto = producto.id_producto,
            codigo_principal = producto.codigo_principal,
            nombre = producto.nombre,
            precio_unitario = producto.precio_unitario,
            stock = producto.stock,
            tarifa_iva = producto.tarifa_iva,
            id_categoria = producto.id_categoria,
            activo = producto.activo
        };

        mostrarFormulario = true;
    }


    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }


    private async Task GuardarProducto()
    {
        try
        {
            error = string.Empty;

            if (string.IsNullOrWhiteSpace(
                productoForm.nombre))
            {
                error =
                    "Ingrese el nombre del producto.";

                return;
            }

            if (productoEditando)
            {
                await ProductoService.ActualizarProducto(
                    productoForm.id_producto,
                    productoForm);
            }
            else
            {
                await ProductoService.CrearProducto(
                    productoForm);
            }

            mostrarFormulario = false;

            await CargarDatos();
        }
        catch (Exception ex)
        {
            error =
                $"Error al guardar el producto: {ex.Message}";
        }
    }


    private async Task DesactivarProducto(
        Producto producto)
    {
        try
        {
            await ProductoService.DesactivarProducto(
                producto.id_producto);

            await CargarDatos();
        }
        catch (Exception ex)
        {
            error =
                $"Error al desactivar: {ex.Message}";
        }
    }


    private string ObtenerNombreCategoria(
        int? idCategoria)
    {
        if (idCategoria == null)
            return "Sin categoría";

        var categoria =
            categorias.FirstOrDefault(
                x => x.id_categoria == idCategoria);

        return categoria?.nombre ?? "Sin categoría";
    }

}

