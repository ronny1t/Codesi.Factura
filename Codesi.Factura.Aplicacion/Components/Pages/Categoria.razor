@code {

    // IMPORTANTE:
    // Se utiliza CategoriaModel porque Categoria.razor
    // también genera una clase llamada Categoria.

    private List<CategoriaModel> todasLasCategorias = new();

    private List<CategoriaModel> categorias = new();

    private CategoriaModel categoriaForm = new();

    private bool cargando = true;

    private bool mostrarFormulario = false;

    private string textoBusqueda = string.Empty;

    private string error = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }


    private async Task CargarCategorias()
    {
        try
        {
            cargando = true;

            error = string.Empty;

            todasLasCategorias =
                await CategoriaService.ObtenerCategorias();

            categorias =
                todasLasCategorias.ToList();
        }
        catch (Exception ex)
        {
            error =
                $"Error al cargar las categorías: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    private void BuscarMientrasEscribe(ChangeEventArgs e)
    {
        textoBusqueda =
            e.Value?.ToString() ?? string.Empty;

        AplicarBusqueda();
    }


    private void AplicarBusqueda()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            categorias =
                todasLasCategorias.ToList();

            return;
        }

        var texto =
            textoBusqueda.Trim();

        categorias =
            todasLasCategorias
                .Where(x =>
                    !string.IsNullOrWhiteSpace(x.nombre)
                    &&
                    x.nombre.Contains(
                        texto,
                        StringComparison.OrdinalIgnoreCase))
                .ToList();
    }


    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;

        categorias =
            todasLasCategorias.ToList();
    }


    private void NuevaCategoria()
    {
        categoriaForm = new CategoriaModel();

        mostrarFormulario = true;
    }


    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }


    private async Task GuardarCategoria()
    {
        try
        {
            error = string.Empty;

            if (string.IsNullOrWhiteSpace(
                categoriaForm.nombre))
            {
                error =
                    "Ingrese el nombre de la categoría.";

                return;
            }

            await CategoriaService.CrearCategoriaAsync(
                categoriaForm);

            mostrarFormulario = false;

            await CargarCategorias();
        }
        catch (Exception ex)
        {
            error =
                $"Error al guardar la categoría: {ex.Message}";
        }
    }


    private async Task DesactivarCategoria(
        CategoriaModel categoria)
    {
        try
        {
            error = string.Empty;

            await CategoriaService.DesactivarCategoriaAsync(
                categoria.id_categoria);

            await CargarCategorias();
        }
        catch (Exception ex)
        {
            error =
                $"Error al desactivar la categoría: {ex.Message}";
        }
    }


    private async Task ActivarCategoria(
        CategoriaModel categoria)
    {
        try
        {
            error = string.Empty;

            await CategoriaService.ActivarCategoriaAsync(
                categoria.id_categoria);

            await CargarCategorias();
        }
        catch (Exception ex)
        {
            error =
                $"Error al activar la categoría: {ex.Message}";
        }
    }

}