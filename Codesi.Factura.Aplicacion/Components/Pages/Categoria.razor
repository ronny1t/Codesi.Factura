@page "/categorias"
@rendermode InteractiveServer

@using Codesi.Factura.Aplicacion.Models
@using Codesi.Factura.Aplicacion.Services

@inject CategoriaService CategoriaService

<PageTitle>Categorías</PageTitle>

<div class="categorias-page">

    <!-- ENCABEZADO -->
    <div class="page-header">

        <div class="page-title">

            <div class="title-icon">
                ◇
            </div>

            <div>
                <h1>Categorías</h1>
                <p>Administra las categorías de tus productos</p>
            </div>

        </div>

        <button class="btn btn-new-category"
                @onclick="NuevaCategoria">

            <span>＋</span>
            <span>Nueva categoría</span>

        </button>

    </div>


    <!-- ESTADÍSTICAS -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon category-icon">
                    ◇
                </div>

                <div class="stat-info">

                    <span>Total categorías</span>

                    <strong>@todasLasCategorias.Count</strong>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon active-icon">
                    ✓
                </div>

                <div class="stat-info">

                    <span>Categorías activas</span>

                    <strong>
                        @todasLasCategorias.Count(x => x.activo)
                    </strong>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon search-icon-card">
                    🔎
                </div>

                <div class="stat-info">

                    <span>Resultados</span>

                    <strong>@categorias.Count</strong>

                </div>

            </div>

        </div>

    </div>


    <!-- BUSCADOR -->
    <div class="search-card">

        <div class="search-title">

            <div>

                <h5>Buscar categorías</h5>

                <span>
                    Busca una categoría por su nombre
                </span>

            </div>

            <span class="search-title-icon">
                🔎
            </span>

        </div>


        <div class="search-box">

            <div class="search-input">

                <span class="search-symbol">
                    🔎
                </span>

                <input class="form-control"
                       placeholder="Ej: bebidas, alimentos, limpieza..."
                       value="@textoBusqueda"
                       @oninput="BuscarMientrasEscribe" />

            </div>


            @if (!string.IsNullOrWhiteSpace(textoBusqueda))
            {
                <button class="btn btn-clear"
                        type="button"
                        title="Limpiar búsqueda"
                        @onclick="LimpiarBusqueda">

                    ✕

                </button>
            }

        </div>

    </div>


    <!-- CONTENIDO -->
    @if (cargando)
    {
        <div class="loading-card">

            <div class="spinner"></div>

            <h5>Cargando categorías...</h5>

            <p>
                Estamos obteniendo las categorías registradas.
            </p>

        </div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="alert custom-alert">

            <span>⚠</span>

            <span>@error</span>

        </div>
    }
    else
    {
        <!-- TABLA -->
        <div class="categories-card">

            <div class="categories-card-header">

                <div>

                    <h5>Lista de categorías</h5>

                    <span>
                        @categorias.Count categoría(s) encontrada(s)
                    </span>

                </div>

                <div class="table-info">

                    <span>●</span>

                    Categorías

                </div>

            </div>


            <div class="table-responsive">

                <table class="table categories-table">

                    <thead>

                        <tr>

                            <th>ID</th>
                            <th>CATEGORÍA</th>
                            <th>ESTADO</th>

                            <th class="text-center">
                                ACCIONES
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (categorias.Count == 0)
                        {
                            <tr>

                                <td colspan="4">

                                    <div class="empty-state">

                                        <div class="empty-icon">
                                            ◇
                                        </div>

                                        <h5>
                                            No se encontraron categorías
                                        </h5>

                                        <p>
                                            Intenta buscar con otro nombre.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var categoria in categorias)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td>

                                        <span class="category-id">
                                            #@categoria.id_categoria
                                        </span>

                                    </td>


                                    <!-- NOMBRE -->
                                    <td>

                                        <div class="category-name">

                                            <div class="category-avatar">
                                                ◇
                                            </div>

                                            <div>

                                                <strong>
                                                    @categoria.nombre
                                                </strong>

                                                <small>
                                                    Categoría #@categoria.id_categoria
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- ESTADO -->
                                    <td>

                                        @if (categoria.activo)
                                        {
                                            <span class="status-badge status-active">

                                                <span>●</span>

                                                Activa

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">

                                                <span>●</span>

                                                Inactiva

                                            </span>
                                        }

                                    </td>


                                    <!-- ACCIONES -->
                                    <td>

                                        <div class="action-buttons">

                                            @if (categoria.activo)
                                            {
                                                <button class="action-btn deactivate-btn"
                                                        type="button"
                                                        title="Desactivar categoría"
                                                        @onclick="() => DesactivarCategoria(categoria)">

                                                    ✕

                                                </button>
                                            }
                                            else
                                            {
                                                <button class="action-btn activate-btn"
                                                        type="button"
                                                        title="Activar categoría"
                                                        @onclick="() => ActivarCategoria(categoria)">

                                                    ✓

                                                </button>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>


<!-- MODAL NUEVA CATEGORÍA -->
@if (mostrarFormulario)
{
    <div class="modal-backdrop-custom"></div>

    <div class="modal d-block category-modal"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <!-- HEADER -->
                <div class="modal-header-custom">

                    <div class="modal-title-container">

                        <div class="modal-icon">
                            ◇
                        </div>

                        <div>

                            <h5>Nueva categoría</h5>

                            <span>
                                Registra una nueva categoría
                            </span>

                        </div>

                    </div>


                    <button type="button"
                            class="close-modal"
                            @onclick="CerrarFormulario">

                        ✕

                    </button>

                </div>


                <!-- BODY -->
                <div class="modal-body-custom">

                    <label>
                        Nombre de la categoría
                    </label>

                    <input class="form-control"
                           placeholder="Ej: Bebidas"
                           @bind="categoriaForm.nombre" />

                </div>


                <!-- FOOTER -->
                <div class="modal-footer-custom">

                    <button class="btn btn-modal-cancel"
                            type="button"
                            @onclick="CerrarFormulario">

                        Cancelar

                    </button>

                    <button class="btn btn-modal-save"
                            type="button"
                            @onclick="GuardarCategoria">

                        Guardar categoría

                    </button>

                </div>

            </div>

        </div>

    </div>
}


