@code {

    private List<clientes> todosLosClientes = new();
    private List<clientes> clientes = new();

    private clientes clienteForm = new();

    private bool cargando = true;
    private bool mostrarFormulario = false;
    private bool clienteEditando = false;

    private string textoBusqueda = string.Empty;
    private string error = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }


    private async Task CargarClientes()
    {
        try
        {
            cargando = true;
            error = string.Empty;

            todosLosClientes =
                await ClienteApiService.ObtenerClientesAsync();

            clientes =
                todosLosClientes.ToList();
        }
        catch (Exception ex)
        {
            error =
                $"Error al cargar los clientes: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    private void BuscarMientrasEscribe(ChangeEventArgs e)
    {
        textoBusqueda =
            e.Value?.ToString() ?? string.Empty;

        AplicarBusqueda();
    }


    private void AplicarBusqueda()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            clientes =
                todosLosClientes.ToList();

            return;
        }

        var texto =
            textoBusqueda.Trim();

        clientes =
            todosLosClientes
                .Where(x =>
                    (!string.IsNullOrWhiteSpace(x.identificacion) &&
                     x.identificacion.Contains(
                         texto,
                         StringComparison.OrdinalIgnoreCase))
                    ||
                    (!string.IsNullOrWhiteSpace(x.razon_social) &&
                     x.razon_social.Contains(
                         texto,
                         StringComparison.OrdinalIgnoreCase))
                    ||
                    (!string.IsNullOrWhiteSpace(x.telefono) &&
                     x.telefono.Contains(
                         texto,
                         StringComparison.OrdinalIgnoreCase))
                    ||
                    (!string.IsNullOrWhiteSpace(x.email) &&
                     x.email.Contains(
                         texto,
                         StringComparison.OrdinalIgnoreCase))
                )
                .ToList();
    }


    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;

        clientes =
            todosLosClientes.ToList();
    }


    private void NuevoCliente()
    {
        clienteEditando = false;

        clienteForm = new clientes();

        mostrarFormulario = true;
    }


    private void EditarCliente(clientes cliente)
    {
        clienteEditando = true;

        clienteForm = new clientes
        {
            id_cliente = cliente.id_cliente,
            tipo_identificacion = cliente.tipo_identificacion,
            identificacion = cliente.identificacion,
            razon_social = cliente.razon_social,
            direccion = cliente.direccion,
            telefono = cliente.telefono,
            email = cliente.email
        };

        mostrarFormulario = true;
    }


    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }


    private async Task GuardarCliente()
    {
        try
        {
            error = string.Empty;

            if (string.IsNullOrWhiteSpace(
                clienteForm.identificacion))
            {
                error =
                    "Ingrese la identificación del cliente.";

                return;
            }

            if (string.IsNullOrWhiteSpace(
                clienteForm.razon_social))
            {
                error =
                    "Ingrese el nombre o razón social.";

                return;
            }


            if (clienteEditando)
            {
                await ClienteApiService.ActualizarClienteAsync(
                    clienteForm.id_cliente,
                    clienteForm);
            }
            else
            {
                await ClienteApiService.CrearClienteAsync(
                    clienteForm);
            }


            mostrarFormulario = false;

            await CargarClientes();
        }
        catch (Exception ex)
        {
            error =
                $"Error al guardar el cliente: {ex.Message}";
        }
    }


    private string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "?";

        var palabras =
            nombre
                .Trim()
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries);

        if (palabras.Length == 1)
            return palabras[0]
                .Substring(
                    0,
                    Math.Min(2, palabras[0].Length))
                .ToUpper();

        return (
            palabras[0][0].ToString() +
            palabras[^1][0].ToString()
        ).ToUpper();
    }

}