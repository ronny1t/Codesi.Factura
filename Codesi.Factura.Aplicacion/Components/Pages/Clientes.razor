@page "/clientes"
@rendermode InteractiveServer

@using Codesi.Factura.Aplicacion.Models
@using Codesi.Factura.Aplicacion.Services

@inject ClienteApiService ClienteApiService

<PageTitle>Clientes</PageTitle>

<div class="clientes-page">

    <!-- ENCABEZADO -->
    <div class="page-header">

        <div class="page-title">

            <div class="title-icon">
                👥
            </div>

            <div>
                <h1>Clientes</h1>
                <p>Administra la información de tus clientes</p>
            </div>

        </div>

        <button class="btn btn-new-client"
                @onclick="NuevoCliente">

            <span>＋</span>

            <span>Nuevo cliente</span>

        </button>

    </div>


    <!-- ESTADÍSTICAS -->
    <div class="row g-3 mb-4">

        <!-- TOTAL CLIENTES -->
        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon clients-icon">
                    👥
                </div>

                <div class="stat-info">

                    <span>Total clientes</span>

                    <strong>@todosLosClientes.Count</strong>

                </div>

            </div>

        </div>


        <!-- RESULTADOS -->
        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon result-icon">
                    🔎
                </div>

                <div class="stat-info">

                    <span>Resultados</span>

                    <strong>@clientes.Count</strong>

                </div>

            </div>

        </div>


        <!-- CORREOS -->
        <div class="col-md-4">

            <div class="stat-card">

                <div class="stat-icon email-icon">
                    ✉
                </div>

                <div class="stat-info">

                    <span>Con correo registrado</span>

                    <strong>
                        @todosLosClientes.Count(x =>
                            !string.IsNullOrWhiteSpace(x.email))
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- BUSCADOR -->
    <div class="search-card">

        <div class="search-title">

            <div>
                <h5>Buscar clientes</h5>

                <span>
                    Busca por identificación, nombre, teléfono o correo
                </span>
            </div>

            <span class="search-title-icon">
                🔎
            </span>

        </div>


        <div class="search-box">

            <div class="search-input">

                <span class="search-icon">
                    🔎
                </span>

                <input class="form-control"
                       placeholder="Ej: 0102030405, Juan, 099..., correo..."
                       value="@textoBusqueda"
                       @oninput="BuscarMientrasEscribe" />

            </div>


            @if (!string.IsNullOrWhiteSpace(textoBusqueda))
            {
                <button class="btn btn-clear"
                        title="Limpiar búsqueda"
                        @onclick="LimpiarBusqueda">

                    ✕

                </button>
            }

        </div>

    </div>


    <!-- CONTENIDO -->
    @if (cargando)
    {
        <div class="loading-card">

            <div class="spinner"></div>

            <h5>Cargando clientes...</h5>

            <p>
                Estamos obteniendo la información de los clientes.
            </p>

        </div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="alert custom-alert">

            <span>⚠</span>

            <span>@error</span>

        </div>
    }
    else
    {
        <!-- TABLA -->
        <div class="clients-card">

            <div class="clients-card-header">

                <div>
                    <h5>Lista de clientes</h5>

                    <span>
                        @clientes.Count cliente(s) encontrado(s)
                    </span>
                </div>

                <div class="table-info">

                    <span>●</span>

                    Clientes

                </div>

            </div>


            <div class="table-responsive">

                <table class="table clients-table">

                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>IDENTIFICACIÓN</th>

                            <th>CLIENTE</th>

                            <th>DIRECCIÓN</th>

                            <th>TELÉFONO</th>

                            <th>CORREO</th>

                            <th class="text-center">
                                ACCIONES
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (clientes.Count == 0)
                        {
                            <tr>

                                <td colspan="7">

                                    <div class="empty-state">

                                        <div class="empty-icon">
                                            👥
                                        </div>

                                        <h5>
                                            No se encontraron clientes
                                        </h5>

                                        <p>
                                            Intenta buscar con otro dato.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var cliente in clientes)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td>

                                        <span class="client-id">
                                            #@cliente.id_cliente
                                        </span>

                                    </td>


                                    <!-- IDENTIFICACIÓN -->
                                    <td>

                                        <div class="identification">

                                            <strong>
                                                @cliente.identificacion
                                            </strong>

                                            <small>
                                                @cliente.tipo_identificacion
                                            </small>

                                        </div>

                                    </td>


                                    <!-- CLIENTE -->
                                    <td>

                                        <div class="client-name">

                                            <div class="client-avatar">
                                                @ObtenerIniciales(
                                                    cliente.razon_social)
                                            </div>

                                            <div>

                                                <strong>
                                                    @cliente.razon_social
                                                </strong>

                                                <small>
                                                    Cliente #@cliente.id_cliente
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- DIRECCIÓN -->
                                    <td>

                                        <span class="address-text">
                                            @(string.IsNullOrWhiteSpace(
                                                cliente.direccion)
                                                ? "Sin dirección"
                                                : cliente.direccion)
                                        </span>

                                    </td>


                                    <!-- TELÉFONO -->
                                    <td>

                                        <span class="phone-text">
                                            @(string.IsNullOrWhiteSpace(
                                                cliente.telefono)
                                                ? "Sin teléfono"
                                                : cliente.telefono)
                                        </span>

                                    </td>


                                    <!-- EMAIL -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            cliente.email))
                                        {
                                            <span class="email-text">
                                                @cliente.email
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="no-data">
                                                Sin correo
                                            </span>
                                        }

                                    </td>


                                    <!-- ACCIONES -->
                                    <td>

                                        <div class="action-buttons">

                                            <button class="action-btn edit-btn"
                                                    title="Editar cliente"
                                                    @onclick="() => EditarCliente(cliente)">

                                                ✎

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>


<!-- MODAL CLIENTE -->
@if (mostrarFormulario)
{
    <div class="modal-backdrop-custom"></div>

    <div class="modal d-block client-modal"
         tabindex="-1">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <!-- HEADER -->
                <div class="modal-header-custom">

                    <div class="modal-title-container">

                        <div class="modal-icon">
                            👤
                        </div>

                        <div>

                            <h5>
                                @(clienteEditando
                                    ? "Editar cliente"
                                    : "Nuevo cliente")
                            </h5>

                            <span>
                                @(clienteEditando
                                    ? "Actualiza la información del cliente"
                                    : "Registra un nuevo cliente")
                            </span>

                        </div>

                    </div>


                    <button type="button"
                            class="close-modal"
                            @onclick="CerrarFormulario">

                        ✕

                    </button>

                </div>


                <!-- BODY -->
                <div class="modal-body-custom">

                    <div class="row g-3">

                        <!-- TIPO IDENTIFICACIÓN -->
                        <div class="col-md-6">

                            <label>
                                Tipo de identificación
                            </label>

                            <select class="form-select"
                                    @bind="clienteForm.tipo_identificacion">

                                <option value="">
                                    Seleccione
                                </option>

                                <option value="Cédula">
                                    Cédula
                                </option>

                                <option value="RUC">
                                    RUC
                                </option>

                                <option value="Pasaporte">
                                    Pasaporte
                                </option>

                            </select>

                        </div>


                        <!-- IDENTIFICACIÓN -->
                        <div class="col-md-6">

                            <label>
                                Identificación
                            </label>

                            <input class="form-control"
                                   placeholder="Ej: 0102030405"
                                   @bind="clienteForm.identificacion" />

                        </div>


                        <!-- RAZÓN SOCIAL -->
                        <div class="col-12">

                            <label>
                                Nombre / Razón social
                            </label>

                            <input class="form-control"
                                   placeholder="Nombre completo o razón social"
                                   @bind="clienteForm.razon_social" />

                        </div>


                        <!-- DIRECCIÓN -->
                        <div class="col-12">

                            <label>
                                Dirección
                            </label>

                            <input class="form-control"
                                   placeholder="Dirección del cliente"
                                   @bind="clienteForm.direccion" />

                        </div>


                        <!-- TELÉFONO -->
                        <div class="col-md-6">

                            <label>
                                Teléfono
                            </label>

                            <input class="form-control"
                                   placeholder="Ej: 0991234567"
                                   @bind="clienteForm.telefono" />

                        </div>


                        <!-- EMAIL -->
                        <div class="col-md-6">

                            <label>
                                Correo electrónico
                            </label>

                            <input type="email"
                                   class="form-control"
                                   placeholder="cliente@correo.com"
                                   @bind="clienteForm.email" />

                        </div>

                    </div>

                </div>


                <!-- FOOTER -->
                <div class="modal-footer-custom">

                    <button class="btn btn-modal-cancel"
                            @onclick="CerrarFormulario">

                        Cancelar

                    </button>

                    <button class="btn btn-modal-save"
                            @onclick="GuardarCliente">

                        @(clienteEditando
                            ? "Guardar cambios"
                            : "Guardar cliente")

                    </button>

                </div>

            </div>

        </div>

    </div>
}


