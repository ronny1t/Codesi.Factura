@code {

    // =====================================================
    // LISTADO
    // =====================================================

    private List<Codesi.Factura.Aplicacion.Models.Factura> facturas = new();

    private List<Codesi.Factura.Aplicacion.Models.Factura> facturasFiltradas = new();

    private Codesi.Factura.Aplicacion.Models.Factura? facturaSeleccionada;

    private List<FacturaDetalle> detalles = new();

    private List<FacturaPago> pagos = new();

    private bool cargando = true;

    private bool mostrarDetalle = false;

    private string? error;

    private string textoBusqueda = string.Empty;


    // =====================================================
    // NUEVA / EDITAR FACTURA
    // =====================================================

    private bool mostrarNuevaFactura = false;

    private bool guardandoFactura = false;

    private bool modoEdicion = false;

    private int idFacturaEditando = 0;

    private DateTime fechaFacturaEditando = DateTime.Now;

    private List<clientes> clientes = new();

    private List<Producto> productos = new();

    private List<Producto> productosBuscados = new();

    private List<FacturaDetalle> detalleFactura = new();

    private int idClienteSeleccionado = 0;

    private string textoProducto = string.Empty;

    private string formaPago = string.Empty;


    // =====================================================
    // INICIALIZACIÓN
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await CargarFacturas();

        try
        {
            productos =
                await ProductoService.ObtenerProductos();
        }
        catch (Exception ex)
        {
            error =
                $"Error al cargar los productos: {ex.Message}";
        }
    }


    // =====================================================
    // CARGAR FACTURAS
    // =====================================================

    private async Task CargarFacturas()
    {
        try
        {
            cargando = true;
            error = null;

            facturas =
                await FacturaService.ObtenerFacturas();

            AplicarBusqueda();
        }
        catch (Exception ex)
        {
            error =
                $"Error al cargar las facturas: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    // =====================================================
    // BÚSQUEDA DE FACTURAS
    // =====================================================

    private void BuscarFacturas(ChangeEventArgs e)
    {
        textoBusqueda =
            e.Value?.ToString() ?? string.Empty;

        AplicarBusqueda();
    }


    private void AplicarBusqueda()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            facturasFiltradas =
                facturas.ToList();

            return;
        }

        var texto =
            textoBusqueda.Trim();

        facturasFiltradas =
            facturas
                .Where(f =>
                    f.id_factura
                        .ToString()
                        .Contains(
                            texto,
                            StringComparison.OrdinalIgnoreCase)

                    ||

                    f.id_cliente
                        .ToString()
                        .Contains(
                            texto,
                            StringComparison.OrdinalIgnoreCase)

                    ||

                    (
                        !string.IsNullOrWhiteSpace(
                            f.estado_sri)

                        &&

                        f.estado_sri.Contains(
                            texto,
                            StringComparison.OrdinalIgnoreCase)
                    )
                )
                .ToList();
    }


    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;

        facturasFiltradas =
            facturas.ToList();
    }


    // =====================================================
    // ABRIR NUEVA FACTURA
    // =====================================================

    private async Task AbrirNuevaFactura()
    {
        try
        {
            error = null;

            modoEdicion = false;

            idFacturaEditando = 0;

            fechaFacturaEditando = DateTime.Now;

            mostrarNuevaFactura = true;

            idClienteSeleccionado = 0;

            textoProducto = string.Empty;

            formaPago = string.Empty;

            detalleFactura.Clear();

            productosBuscados.Clear();

            if (clientes.Count == 0)
            {
                clientes =
                    await ClienteApiService
                        .ObtenerClientesAsync();
            }

            if (productos.Count == 0)
            {
                productos =
                    await ProductoService
                        .ObtenerProductos();
            }
        }
        catch (Exception ex)
        {
            mostrarNuevaFactura = false;

            error =
                $"Error al cargar los datos para la factura: {ex.Message}";
        }
    }


    // =====================================================
    // CERRAR NUEVA / EDITAR
    // =====================================================

    private void CerrarNuevaFactura()
    {
        if (guardandoFactura)
            return;

        mostrarNuevaFactura = false;

        modoEdicion = false;

        idFacturaEditando = 0;

        fechaFacturaEditando = DateTime.Now;

        idClienteSeleccionado = 0;

        textoProducto = string.Empty;

        formaPago = string.Empty;

        detalleFactura.Clear();

        productosBuscados.Clear();
    }


    // =====================================================
    // EDITAR FACTURA
    // =====================================================

    private async Task AbrirEditarFactura(int id)
    {
        try
        {
            error = null;

            if (clientes.Count == 0)
            {
                clientes =
                    await ClienteApiService
                        .ObtenerClientesAsync();
            }

            if (productos.Count == 0)
            {
                productos =
                    await ProductoService
                        .ObtenerProductos();
            }

            var factura =
                await FacturaService
                    .ObtenerFacturaPorId(id);

            if (factura == null)
            {
                error =
                    "No se encontró la factura.";

                return;
            }

            if (!EsEditable(factura))
            {
                error =
                    "Esta factura no se puede editar porque ya no está en estado CREADA.";

                return;
            }

            var detallesExistentes =
                await FacturaService
                    .ObtenerDetalles(id);

            var pagosExistentes =
                await FacturaService
                    .ObtenerPagos(id);

            idFacturaEditando = id;

            fechaFacturaEditando =
                factura.fecha_emision;

            idClienteSeleccionado =
                factura.id_cliente;

            detalleFactura =
                detallesExistentes
                    .Select(d => new FacturaDetalle
                    {
                        id_detalle =
                            d.id_detalle,

                        id_factura =
                            id,

                        id_producto =
                            d.id_producto,

                        cantidad =
                            d.cantidad,

                        precio_unitario =
                            d.precio_unitario,

                        descuento =
                            d.descuento,

                        subtotal =
                            d.subtotal,

                        valor_iva =
                            d.valor_iva,

                        total =
                            d.total
                    })
                    .ToList();

            formaPago =
                pagosExistentes
                    .FirstOrDefault()
                    ?.forma_pago
                ?? string.Empty;

            textoProducto = string.Empty;

            productosBuscados.Clear();

            modoEdicion = true;

            mostrarDetalle = false;

            facturaSeleccionada = null;

            mostrarNuevaFactura = true;
        }
        catch (Exception ex)
        {
            error =
                $"Error al cargar la factura para editar: {ex.Message}";
        }
    }


    // =====================================================
    // BUSCAR PRODUCTOS
    // =====================================================

    private void BuscarProductos(ChangeEventArgs e)
    {
        textoProducto =
            e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(textoProducto))
        {
            productosBuscados.Clear();

            return;
        }

        var texto =
            textoProducto.Trim();

        productosBuscados =
            productos
                .Where(p =>
                    p.activo

                    &&

                    (
                        (
                            !string.IsNullOrWhiteSpace(
                                p.nombre)

                            &&

                            p.nombre.Contains(
                                texto,
                                StringComparison.OrdinalIgnoreCase)
                        )

                        ||

                        (
                            !string.IsNullOrWhiteSpace(
                                p.codigo_principal)

                            &&

                            p.codigo_principal.Contains(
                                texto,
                                StringComparison.OrdinalIgnoreCase)
                        )
                    )
                )
                .Take(10)
                .ToList();
    }


    // =====================================================
    // AGREGAR PRODUCTO
    // =====================================================

    private void AgregarProducto(Producto producto)
    {
        if (!producto.activo)
            return;

        if (producto.stock <= 0)
        {
            error =
                $"El producto '{producto.nombre}' no tiene stock disponible.";

            return;
        }

        var existente =
            detalleFactura.FirstOrDefault(
                d => d.id_producto ==
                     producto.id_producto);

        if (existente != null)
        {
            if (existente.cantidad >= producto.stock)
            {
                error =
                    $"No hay más stock disponible de '{producto.nombre}'.";

                return;
            }

            existente.cantidad++;

            RecalcularDetalle(existente);
        }
        else
        {
            var detalle =
                new FacturaDetalle
                {
                    id_producto =
                        producto.id_producto,

                    cantidad = 1,

                    precio_unitario =
                        producto.precio_unitario,

                    descuento = 0
                };

            RecalcularDetalle(detalle);

            detalleFactura.Add(detalle);
        }

        error = null;

        textoProducto = string.Empty;

        productosBuscados.Clear();
    }


    // =====================================================
    // CAMBIAR CANTIDAD
    // =====================================================

    private void CambiarCantidad(
        FacturaDetalle detalle,
        ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out int cantidad))
        {
            var producto =
                productos.FirstOrDefault(
                    p => p.id_producto ==
                         detalle.id_producto);

            if (cantidad < 1)
                cantidad = 1;

            if (producto != null &&
                cantidad > producto.stock)
            {
                cantidad = producto.stock;

                error =
                    $"La cantidad no puede superar el stock disponible de '{producto.nombre}'.";
            }
            else
            {
                error = null;
            }

            detalle.cantidad =
                cantidad;

            RecalcularDetalle(detalle);
        }
    }


    // =====================================================
    // RECALCULAR DETALLE
    // =====================================================

    private void RecalcularDetalle(
        FacturaDetalle detalle)
    {
        var producto =
            productos.FirstOrDefault(
                p => p.id_producto ==
                     detalle.id_producto);

        decimal precio =
            detalle.precio_unitario;

        decimal descuento =
            detalle.descuento ?? 0;

        decimal subtotal =
            (precio * detalle.cantidad) -
            descuento;

        if (subtotal < 0)
            subtotal = 0;

        decimal porcentajeIva =
            producto?.tarifa_iva ?? 15;

        decimal iva =
            subtotal *
            (porcentajeIva / 100m);

        decimal total =
            subtotal + iva;

        detalle.subtotal =
            subtotal;

        detalle.valor_iva =
            iva;

        detalle.total =
            total;
    }


    // =====================================================
    // ELIMINAR PRODUCTO
    // =====================================================

    private void EliminarProducto(
        FacturaDetalle detalle)
    {
        detalleFactura.Remove(detalle);

        error = null;
    }


    // =====================================================
    // NOMBRE PRODUCTO
    // =====================================================

    private string ObtenerNombreProducto(
        int idProducto)
    {
        return productos
                   .FirstOrDefault(
                       p => p.id_producto ==
                            idProducto)
                   ?.nombre
               ?? $"Producto #{idProducto}";
    }


    // =====================================================
    // TOTALES
    // =====================================================

    private decimal Subtotal =>
        detalleFactura.Sum(
            x => x.subtotal);

    private decimal IvaTotal =>
        detalleFactura.Sum(
            x => x.valor_iva);

    private decimal TotalFactura =>
        detalleFactura.Sum(
            x => x.total);


    // =====================================================
    // GUARDAR FACTURA
    // =====================================================

    private async Task GuardarFactura()
    {
        if (modoEdicion)
        {
            await ActualizarFactura();
        }
        else
        {
            await CrearFactura();
        }
    }


    // =====================================================
    // CREAR FACTURA
    // =====================================================

    private async Task CrearFactura()
    {
        if (guardandoFactura)
            return;

        error = null;

        if (idClienteSeleccionado <= 0)
        {
            error =
                "Debe seleccionar un cliente.";

            return;
        }

        if (detalleFactura.Count == 0)
        {
            error =
                "Debe agregar al menos un producto.";

            return;
        }

        if (string.IsNullOrWhiteSpace(formaPago))
        {
            error =
                "Debe seleccionar una forma de pago.";

            return;
        }

        foreach (var detalle in detalleFactura)
        {
            var producto =
                productos.FirstOrDefault(
                    p => p.id_producto ==
                         detalle.id_producto);

            if (producto == null)
            {
                error =
                    $"No se encontró el producto {detalle.id_producto}.";

                return;
            }

            if (detalle.cantidad > producto.stock)
            {
                error =
                    $"El producto '{producto.nombre}' no tiene suficiente stock.";

                return;
            }
        }

        guardandoFactura = true;

        try
        {
            decimal subtotal =
                detalleFactura.Sum(
                    x => x.subtotal);

            decimal iva =
                detalleFactura.Sum(
                    x => x.valor_iva);

            decimal descuento =
                detalleFactura.Sum(
                    x => x.descuento ?? 0);

            decimal total =
                detalleFactura.Sum(
                    x => x.total);


            // ---------------------------------------------
            // CABECERA
            // ---------------------------------------------

            var facturaNueva =
                new Codesi.Factura.Aplicacion.Models.Factura
                {
                    id_cliente =
                        idClienteSeleccionado,

                    establecimiento =
                        "001",

                    punto_emision =
                        "001",

                    fecha_emision =
                        DateTime.Now,

                    subtotal_sin_impuestos =
                        subtotal,

                    total_descuento =
                        descuento,

                    subtotal_iva =
                        iva,

                    propina =
                        0,

                    importe_total =
                        total,

                    estado_sri =
                        "CREADA",

                    clave_acceso =
                        Guid.NewGuid()
                            .ToString("N")
                };


            // ---------------------------------------------
            // GUARDAR CABECERA
            // ---------------------------------------------

            Console.WriteLine("====================================");
            Console.WriteLine("ENVIANDO FACTURA DESDE BLAZOR");
            Console.WriteLine(
                $"idClienteSeleccionado: {idClienteSeleccionado}");
            Console.WriteLine(
                $"facturaNueva.id_cliente: {facturaNueva.id_cliente}");
            Console.WriteLine(
                $"Clientes cargados: {clientes.Count}");

            foreach (var cliente in clientes)
            {
                Console.WriteLine(
                    $"Cliente -> ID: {cliente.id_cliente}, " +
                    $"Identificación: {cliente.identificacion}, " +
                    $"Nombre: {cliente.razon_social}");
            }

            Console.WriteLine("====================================");

            var facturaCreada =
                await FacturaService
                    .CrearFactura(facturaNueva);

            if (facturaCreada == null)
            {
                throw new Exception(
                    "La API no devolvió la factura creada.");
            }

            int idFactura =
                facturaCreada.id_factura;

            if (idFactura <= 0)
            {
                throw new Exception(
                    "La factura fue creada pero no se recibió un ID válido.");
            }


            // ---------------------------------------------
            // GUARDAR DETALLES
            // ---------------------------------------------

            foreach (var detalle in detalleFactura)
            {
                detalle.id_factura =
                    idFactura;

                var detalleCreado =
                    await FacturaService
                        .CrearDetalle(detalle);

                if (detalleCreado == null)
                {
                    throw new Exception(
                        $"No se pudo guardar el detalle del producto {detalle.id_producto}.");
                }
            }


            // ---------------------------------------------
            // GUARDAR PAGO
            // ---------------------------------------------

            var pago =
                new FacturaPago
                {
                    id_factura =
                        idFactura,

                    forma_pago =
                        formaPago,

                    total =
                        total
                };

            var pagoCreado =
                await FacturaService
                    .CrearPago(pago);

            if (pagoCreado == null)
            {
                throw new Exception(
                    "La factura se creó, pero no se pudo registrar el pago.");
            }


            // ---------------------------------------------
            // LIMPIAR
            // ---------------------------------------------

            mostrarNuevaFactura =
                false;

            modoEdicion =
                false;

            idFacturaEditando =
                0;

            idClienteSeleccionado =
                0;

            textoProducto =
                string.Empty;

            formaPago =
                string.Empty;

            detalleFactura.Clear();

            productosBuscados.Clear();


            // ---------------------------------------------
            // ACTUALIZAR LISTADO
            // ---------------------------------------------

            await CargarFacturas();
        }
        catch (Exception ex)
        {
            error =
                $"Error al crear la factura: {ex.Message}";
        }
        finally
        {
            guardandoFactura =
                false;
        }
    }


    // =====================================================
    // ACTUALIZAR FACTURA
    // =====================================================

    private async Task ActualizarFactura()
    {
        if (guardandoFactura)
            return;

        error = null;

        // ---------------------------------------------
        // VALIDACIONES
        // ---------------------------------------------

        if (idFacturaEditando <= 0)
        {
            error =
                "No se identificó la factura que se desea editar.";

            return;
        }

        if (idClienteSeleccionado <= 0)
        {
            error =
                "Debe seleccionar un cliente.";

            return;
        }

        if (detalleFactura.Count == 0)
        {
            error =
                "Debe agregar al menos un producto.";

            return;
        }

        if (string.IsNullOrWhiteSpace(formaPago))
        {
            error =
                "Debe seleccionar una forma de pago.";

            return;
        }


        // ---------------------------------------------
        // VERIFICAR STOCK
        // ---------------------------------------------

        foreach (var detalle in detalleFactura)
        {
            var producto =
                productos.FirstOrDefault(
                    p => p.id_producto ==
                         detalle.id_producto);

            if (producto == null)
            {
                error =
                    $"No se encontró el producto {detalle.id_producto}.";

                return;
            }

            if (!producto.activo)
            {
                error =
                    $"El producto '{producto.nombre}' está inactivo.";

                return;
            }

            if (detalle.cantidad > producto.stock)
            {
                error =
                    $"El producto '{producto.nombre}' no tiene suficiente stock.";

                return;
            }
        }


        guardandoFactura = true;

        try
        {
            // ---------------------------------------------
            // RECALCULAR DETALLES
            // ---------------------------------------------

            foreach (var detalle in detalleFactura)
            {
                RecalcularDetalle(detalle);

                detalle.id_factura =
                    idFacturaEditando;
            }


            decimal subtotal =
                detalleFactura.Sum(
                    x => x.subtotal);

            decimal iva =
                detalleFactura.Sum(
                    x => x.valor_iva);

            decimal descuento =
                detalleFactura.Sum(
                    x => x.descuento ?? 0);

            decimal total =
                detalleFactura.Sum(
                    x => x.total);


            // ---------------------------------------------
            // CREAR OBJETO PARA ACTUALIZAR
            // ---------------------------------------------

            var facturaActualizada =
                new Codesi.Factura.Aplicacion.Models.Factura
                {
                    id_factura =
                        idFacturaEditando,

                    id_cliente =
                        idClienteSeleccionado,

                    fecha_emision =
                        fechaFacturaEditando,

                    subtotal_sin_impuestos =
                        subtotal,

                    total_descuento =
                        descuento,

                    subtotal_iva =
                        iva,

                    propina =
                        0,

                    importe_total =
                        total,

                    estado_sri =
                        "CREADA"
                };


            // ---------------------------------------------
            // ACTUALIZAR API
            // ---------------------------------------------

            await FacturaService
                .ActualizarFactura(
                    idFacturaEditando,
                    facturaActualizada,
                    detalleFactura,
                    formaPago,
                    total
                );


            // ---------------------------------------------
            // LIMPIAR
            // ---------------------------------------------

            mostrarNuevaFactura =
                false;

            modoEdicion =
                false;

            idFacturaEditando =
                0;

            fechaFacturaEditando =
                DateTime.Now;

            idClienteSeleccionado =
                0;

            textoProducto =
                string.Empty;

            formaPago =
                string.Empty;

            detalleFactura.Clear();

            productosBuscados.Clear();


            // ---------------------------------------------
            // ACTUALIZAR LISTADO
            // ---------------------------------------------

            await CargarFacturas();
        }
        catch (Exception ex)
        {
            error =
                $"Error al actualizar la factura: {ex.Message}";
        }
        finally
        {
            guardandoFactura =
                false;
        }
    }


    // =====================================================
    // VER FACTURA
    // =====================================================

    private async Task VerFactura(int id)
    {
        try
        {
            error = null;

            facturaSeleccionada =
                await FacturaService
                    .ObtenerFacturaPorId(id);

            if (facturaSeleccionada == null)
            {
                error =
                    "No se encontró la factura.";

                return;
            }

            detalles =
                await FacturaService
                    .ObtenerDetalles(id);

            pagos =
                await FacturaService
                    .ObtenerPagos(id);

            mostrarDetalle =
                true;
        }
        catch (Exception ex)
        {
            error =
                $"Error al obtener la factura: {ex.Message}";
        }
    }


    // =====================================================
    // CERRAR DETALLE
    // =====================================================

    private void CerrarDetalle()
    {
        mostrarDetalle =
            false;

        facturaSeleccionada =
            null;

        detalles.Clear();

        pagos.Clear();
    }


    // =====================================================
    // AUTORIZAR
    // =====================================================

    private async Task AutorizarFactura(
        int id)
    {
        try
        {
            error = null;

            await FacturaService
                .ActualizarEstado(
                    id,
                    "AUTORIZADA");

            mostrarDetalle = false;

            await CargarFacturas();
        }
        catch (Exception ex)
        {
            error =
                $"Error al actualizar el estado: {ex.Message}";
        }
    }


    // =====================================================
    // ESTADO AUTORIZADA
    // =====================================================

    private bool EsAutorizada(
        Codesi.Factura.Aplicacion.Models.Factura factura)
    {
        return string.Equals(
            factura.estado_sri,
            "AUTORIZADA",
            StringComparison.OrdinalIgnoreCase);
    }


    // =====================================================
    // ESTADO EDITABLE
    // =====================================================

    private bool EsEditable(
        Codesi.Factura.Aplicacion.Models.Factura factura)
    {
        return string.Equals(
            factura.estado_sri,
            "CREADA",
            StringComparison.OrdinalIgnoreCase);
    }


    // =====================================================
    // INICIAL CLIENTE
    // =====================================================

    private string ObtenerInicialCliente(
        int idCliente)
    {
        return idCliente
            .ToString()
            .FirstOrDefault()
            .ToString();
    }


    // =====================================================
    // RENDER ESTADO
    // =====================================================

    private RenderFragment RenderEstado(
        string? estado)
    {
        var estadoNormalizado =
            string.IsNullOrWhiteSpace(estado)
                ? "PENDIENTE"
                : estado.ToUpperInvariant();

        var clase =
            estadoNormalizado switch
            {
                "AUTORIZADA" =>
                    "status-authorized",

                "RECHAZADA" =>
                    "status-rejected",

                "PENDIENTE" =>
                    "status-pending",

                _ =>
                    "status-other"
            };

        return builder =>
        {
            builder.OpenElement(
                0,
                "span");

            builder.AddAttribute(
                1,
                "class",
                $"status-badge {clase}");

            builder.OpenElement(
                2,
                "span");

            builder.AddAttribute(
                3,
                "class",
                "status-dot");

            builder.CloseElement();

            builder.AddContent(
                4,
                estadoNormalizado);

            builder.CloseElement();
        };
    }

