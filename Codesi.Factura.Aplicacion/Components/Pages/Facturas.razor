@page "/facturas"
@rendermode InteractiveServer
@using Codesi.Factura.Aplicacion.Models
@using Codesi.Factura.Aplicacion.Services

@inject FacturaService FacturaService
@inject ClienteApiService ClienteApiService
@inject ProductoService ProductoService

<PageTitle>Facturas</PageTitle>

<div class="facturas-page">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <div class="page-header">

        <div>
            <h1>Facturas</h1>

            <p>
                Gestión de facturas y comprobantes registrados
            </p>
        </div>

        <div class="header-actions">

            <button class="btn-refresh"
                    @onclick="CargarFacturas"
                    disabled="@cargando">

                @if (cargando)
                {
                    <span class="small-loader"></span>
                }
                else
                {
                    <span>↻</span>
                }

                Actualizar

            </button>

            <button class="btn-new"
                    @onclick="AbrirNuevaFactura">

                <span>+</span>

                Nueva factura

            </button>

        </div>

    </div>


    <!-- =====================================================
         ERROR
         ===================================================== -->
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert-error">

            <span class="alert-icon">!</span>

            <span>@error</span>

            <button @onclick="() => error = null">
                ×
            </button>

        </div>
    }


    <!-- =====================================================
         ESTADÍSTICAS
         ===================================================== -->

    <div class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon blue">
                📄
            </div>

            <div>
                <span class="stat-label">
                    Total facturas
                </span>

                <strong>
                    @facturas.Count
                </strong>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon green">
                ✓
            </div>

            <div>
                <span class="stat-label">
                    Autorizadas
                </span>

                <strong>
                    @facturas.Count(EsAutorizada)
                </strong>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon orange">
                ⏳
            </div>

            <div>
                <span class="stat-label">
                    Pendientes
                </span>

                <strong>
                    @facturas.Count(f =>
                        string.Equals(
                            f.estado_sri,
                            "PENDIENTE",
                            StringComparison.OrdinalIgnoreCase))
                </strong>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon purple">
                $
            </div>

            <div>
                <span class="stat-label">
                    Total vendido
                </span>

                <strong>
                    @facturas.Sum(f => f.importe_total).ToString("C2")
                </strong>
            </div>

        </div>

    </div>


    <!-- =====================================================
         BÚSQUEDA
         ===================================================== -->

    <div class="search-container">

        <div class="search-box">

            <span class="search-icon">
                🔍
            </span>

            <input type="text"
                   placeholder="Buscar por factura, cliente o estado..."
                   value="@textoBusqueda"
                   @oninput="BuscarFacturas" />

            @if (!string.IsNullOrWhiteSpace(textoBusqueda))
            {
                <button class="clear-search"
                        @onclick="LimpiarBusqueda">
                    ×
                </button>
            }

        </div>

        <span class="results-count">
            @facturasFiltradas.Count factura(s)
        </span>

    </div>


    <!-- =====================================================
         LISTADO
         ===================================================== -->
    @if (cargando)
    {
        <div class="loading-container">

            <div class="loader"></div>

            <p>
                Cargando facturas...
            </p>

        </div>
    }
    else if (facturasFiltradas.Count == 0)
    {
        <div class="empty-state">

            <div class="empty-icon">
                📄
            </div>

            <h3>
                No existen facturas
            </h3>

            <p>
                Todavía no hay facturas registradas en el sistema.
            </p>

            <button class="btn-new"
                    @onclick="AbrirNuevaFactura">

                <span>+</span>

                Crear primera factura

            </button>

        </div>
    }
    else
    {
        <div class="table-card">

            <div class="table-wrapper">

                <table class="facturas-table">

                    <thead>

                        <tr>

                            <th>
                                Factura
                            </th>

                            <th>
                                Cliente
                            </th>

                            <th>
                                Fecha
                            </th>

                            <th>
                                Total
                            </th>

                            <th>
                                Estado
                            </th>

                            <th>
                                Acciones
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var factura in facturasFiltradas)
                        {
                            <tr>

                                <td>

                                    <div class="invoice-number">

                                        <div class="invoice-icon">
                                            #
                                        </div>

                                        <div>

                                            <strong>
                                                @factura.id_factura
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(
                                                factura.secuencial))
                                            {
                                                <small>
                                                    @factura.establecimiento-
                                                    @factura.punto_emision-
                                                    @factura.secuencial
                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    <div class="client-cell">

                                        <div class="client-avatar">
                                            @ObtenerInicialCliente(
                                                factura.id_cliente)
                                        </div>

                                        <span>
                                            Cliente #@factura.id_cliente
                                        </span>

                                    </div>

                                </td>


                                <td>

                                    <div class="date-cell">

                                        <strong>
                                            @factura.fecha_emision.ToString("dd/MM/yyyy")
                                        </strong>

                                        <small>
                                            @factura.fecha_emision.ToString("HH:mm")
                                        </small>

                                    </div>

                                </td>


                                <td>

                                    <strong class="amount">
                                        @factura.importe_total.ToString("C2")
                                    </strong>

                                </td>


                                <td>

                                    @RenderEstado(factura.estado_sri)

                                </td>


                                <td>

                                    <div class="actions">

                                        <!-- VER -->

                                        <button class="btn-action view"
                                                title="Ver factura"
                                                @onclick="() => VerFactura(
                                                                                                factura.id_factura)">

👁

</button>


                                        <!-- EDITAR -->
                                        @if (EsEditable(factura))
                                        {
                                            <button class="btn-action edit"
                                                    title="Editar factura"
                                                    @onclick="() => AbrirEditarFactura(
                                                                                                        factura.id_factura)">

✏️

</button>
                                        }


                                        <!-- AUTORIZAR -->
                                        @if (!EsAutorizada(factura))
                                        {
                                            <button class="btn-action authorize"
                                                    title="Autorizar"
                                                    @onclick="() => AutorizarFactura(
                                                                                                        factura.id_factura)">

✓

</button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }


    <!-- =====================================================
         MODAL NUEVA / EDITAR FACTURA
         ===================================================== -->
    @if (mostrarNuevaFactura)
    {
        <div class="modal-overlay">

            <div class="modal modal-large">

                <div class="modal-header">

                    <div>

                        <h2>
                            @(modoEdicion
                                ? $"Editar factura #{idFacturaEditando}"
                                : "Nueva factura")
                        </h2>

                        <p>
                            @(modoEdicion
                                ? "Modifica los datos de la factura"
                                : "Registra una nueva venta")
                        </p>

                    </div>

                    <button class="modal-close"
                            @onclick="CerrarNuevaFactura"
                            disabled="@guardandoFactura">

                        ×

                    </button>

                </div>


                <div class="modal-body">

                    <!-- =================================================
                         CLIENTE
                         ================================================= -->

                    <div class="form-section">

                        <h3>
                            Información del cliente
                        </h3>

                        <div class="form-group">

                            <label>
                                Cliente
                            </label>

                            <select class="form-control"
                                    @bind="idClienteSeleccionado">

                                <option value="0">
                                    Seleccione un cliente
                                </option>

                                @foreach (var cliente in clientes)
                                {
                                    <option value="@cliente.id_cliente">

                                        @cliente.identificacion -
                                        @cliente.razon_social

                                    </option>
                                }

                            </select>

                        </div>

                    </div>


                    <!-- =================================================
                         PRODUCTOS
                         ================================================= -->

                    <div class="form-section">

                        <h3>
                            Productos
                        </h3>

                        <div class="product-search">

                            <div class="search-box">

                                <span class="search-icon">
                                    🔍
                                </span>

                                <input type="text"
                                       placeholder="Buscar por nombre o código..."
                                       value="@textoProducto"
                                       @oninput="BuscarProductos" />

                            </div>


                            @if (productosBuscados.Count > 0)
                            {
                                <div class="product-results">

                                    @foreach (var producto in productosBuscados)
                                    {
                                        <button class="product-result"
                                                @onclick="() => AgregarProducto(producto)">

                                            <div class="product-info">

                                                <strong>
                                                    @producto.nombre
                                                </strong>

                                                <small>
                                                    Código:
                                                    @(producto.codigo_principal ?? "Sin código")
                                                </small>

                                            </div>

                                            <div class="product-price">

                                                <strong>
                                                    @producto.precio_unitario.ToString("C2")
                                                </strong>

                                                <small>
                                                    Stock:
                                                    @producto.stock
                                                </small>

                                            </div>

                                        </button>
                                    }

                                </div>
                            }

                        </div>


                        @if (detalleFactura.Count == 0)
                        {
                            <div class="products-empty">

                                <span>
                                    🛒
                                </span>

                                <p>
                                    Agrega productos a la factura
                                </p>

                            </div>
                        }
                        else
                        {
                            <div class="detail-table-wrapper">

                                <table class="detail-table">

                                    <thead>

                                        <tr>

                                            <th>
                                                Producto
                                            </th>

                                            <th>
                                                Precio
                                            </th>

                                            <th>
                                                Cantidad
                                            </th>

                                            <th>
                                                IVA
                                            </th>

                                            <th>
                                                Total
                                            </th>

                                            <th>
                                            </th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var item in detalleFactura)
                                        {
                                            <tr>

                                                <td>

                                                    <strong>
                                                        @ObtenerNombreProducto(
                                                            item.id_producto)
                                                    </strong>

                                                </td>


                                                <td>
                                                    @item.precio_unitario.ToString("C2")
                                                </td>


                                                <td>

                                                    <input type="number"
                                                           class="quantity-input"
                                                           min="1"
                                                           value="@item.cantidad"
                                                           @onchange="(e) => CambiarCantidad(item, e)" />

                                                </td>


                                                <td>
                                                    @item.valor_iva.ToString("C2")
                                                </td>


                                                <td>

                                                    <strong>
                                                        @item.total.ToString("C2")
                                                    </strong>

                                                </td>


                                                <td>

                                                    <button class="btn-remove"
                                                            title="Eliminar"
                                                            @onclick="() => EliminarProducto(item)">

                                                        ×

                                                    </button>

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         PAGO
                         ================================================= -->

                    <div class="form-section">

                        <h3>
                            Forma de pago
                        </h3>

                        <div class="form-group">

                            <label>
                                Método de pago
                            </label>

                            <select class="form-control"
                                    @bind="formaPago">

                                <option value="">
                                    Seleccione una forma de pago
                                </option>

                                <option value="EFECTIVO">
                                    Efectivo
                                </option>

                                <option value="TARJETA">
                                    Tarjeta
                                </option>

                                <option value="TRANSFERENCIA">
                                    Transferencia
                                </option>

                                <option value="DEPOSITO">
                                    Depósito
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- =================================================
                         RESUMEN
                         ================================================= -->

                    <div class="invoice-summary">

                        <div class="summary-row">

                            <span>
                                Subtotal
                            </span>

                            <strong>
                                @Subtotal.ToString("C2")
                            </strong>

                        </div>


                        <div class="summary-row">

                            <span>
                                IVA
                            </span>

                            <strong>
                                @IvaTotal.ToString("C2")
                            </strong>

                        </div>


                        <div class="summary-total">

                            <span>
                                Total
                            </span>

                            <strong>
                                @TotalFactura.ToString("C2")
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     FOOTER
                     ================================================= -->

                <div class="modal-footer">

                    <button class="btn-modal-secondary"
                            @onclick="CerrarNuevaFactura"
                            disabled="@guardandoFactura">

                        Cancelar

                    </button>


                    <button class="btn-create"
                            @onclick="GuardarFactura"
                            disabled="@guardandoFactura">

                        @if (guardandoFactura)
                        {
                            <span class="small-loader"></span>

                            <span>
                                Guardando...
                            </span>
                        }
                        else
                        {
                            <span>
                                ✓
                            </span>

                            <span>
                                @(modoEdicion
                                    ? "Guardar cambios"
                                    : "Crear factura")
                            </span>
                        }

                    </button>

                </div>

            </div>

        </div>
    }


    <!-- =====================================================
         MODAL DETALLE FACTURA
         ===================================================== -->
    @if (mostrarDetalle && facturaSeleccionada != null)
    {
        <div class="modal-overlay">

            <div class="modal modal-large">

                <div class="modal-header">

                    <div>

                        <h2>
                            Factura #@facturaSeleccionada.id_factura
                        </h2>

                        <p>
                            Detalle de la factura
                        </p>

                    </div>

                    <button class="modal-close"
                            @onclick="CerrarDetalle">

                        ×

                    </button>

                </div>


                <div class="modal-body">

                    <!-- INFORMACIÓN -->

                    <div class="invoice-info-grid">

                        <div class="info-item">

                            <span>
                                Cliente
                            </span>

                            <strong>
                                Cliente #@facturaSeleccionada.id_cliente
                            </strong>

                        </div>


                        <div class="info-item">

                            <span>
                                Fecha
                            </span>

                            <strong>
                                @facturaSeleccionada.fecha_emision.ToString(
                                    "dd/MM/yyyy HH:mm")
                            </strong>

                        </div>


                        <div class="info-item">

                            <span>
                                Estado
                            </span>

                            @RenderEstado(
                                facturaSeleccionada.estado_sri)

                        </div>


                        <div class="info-item">

                            <span>
                                Total
                            </span>

                            <strong class="detail-total">
                                @facturaSeleccionada.importe_total.ToString("C2")
                            </strong>

                        </div>

                    </div>


                    <!-- DETALLES -->

                    <div class="form-section">

                        <h3>
                            Productos facturados
                        </h3>

                        @if (detalles.Count == 0)
                        {
                            <div class="details-empty">

                                No existen detalles registrados.

                            </div>
                        }
                        else
                        {
                            <div class="detail-table-wrapper">

                                <table class="detail-table">

                                    <thead>

                                        <tr>

                                            <th>
                                                Producto
                                            </th>

                                            <th>
                                                Cantidad
                                            </th>

                                            <th>
                                                Precio
                                            </th>

                                            <th>
                                                Subtotal
                                            </th>

                                            <th>
                                                IVA
                                            </th>

                                            <th>
                                                Total
                                            </th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var detalle in detalles)
                                        {
                                            <tr>

                                                <td>
                                                    @ObtenerNombreProducto(
                                                        detalle.id_producto)
                                                </td>

                                                <td>
                                                    @detalle.cantidad
                                                </td>

                                                <td>
                                                    @detalle.precio_unitario.ToString("C2")
                                                </td>

                                                <td>
                                                    @detalle.subtotal.ToString("C2")
                                                </td>

                                                <td>
                                                    @detalle.valor_iva.ToString("C2")
                                                </td>

                                                <td>
                                                    <strong>
                                                        @detalle.total.ToString("C2")
                                                    </strong>
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>


                    <!-- PAGOS -->

                    <div class="form-section">

                        <h3>
                            Pagos
                        </h3>

                        @if (pagos.Count == 0)
                        {
                            <div class="details-empty">

                                No existen pagos registrados.

                            </div>
                        }
                        else
                        {
                            <div class="payment-list">

                                @foreach (var pago in pagos)
                                {
                                    <div class="payment-item">

                                        <div>

                                            <strong>
                                                @pago.forma_pago
                                            </strong>

                                            <small>
                                                Pago registrado
                                            </small>

                                        </div>

                                        <strong>
                                            @pago.total.ToString("C2")
                                        </strong>

                                    </div>
                                }

                            </div>
                        }

                    </div>

                </div>


                <!-- FOOTER DETALLE -->

                <div class="modal-footer">

                    <button class="btn-modal-secondary"
                            @onclick="CerrarDetalle">

                        Cerrar

                    </button>


                    @if (EsEditable(facturaSeleccionada))
                    {
                        <button class="btn-create"
                                @onclick="() => AbrirEditarFactura(
                                                                facturaSeleccionada.id_factura)">

✏️

                            Editar factura

</button>
                    }


                    @if (!EsAutorizada(facturaSeleccionada))
                    {
                        <button class="btn-create"
                                @onclick="() => AutorizarFactura(
                                                                facturaSeleccionada.id_factura)">

✓

                            Autorizar factura

</button>
                    }

                </div>

            </div>

        </div>
    }

</div>


<!-- =========================================================
     ESTILOS
     ========================================================= -->

<style>

    .facturas-page {
        padding: 28px;
        background: #f8fafc;
        min-height: 100vh;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .page-header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
            color: #172033;
        }

        .page-header p {
            margin: 6px 0 0;
            color: #64748b;
        }

    .header-actions {
        display: flex;
        gap: 12px;
    }

    button {
        border: none;
        cursor: pointer;
    }

        button:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    .btn-refresh,
    .btn-new,
    .btn-create,
    .btn-modal-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 18px;
        border-radius: 9px;
        font-weight: 600;
        transition: .2s;
    }

    .btn-refresh {
        background: white;
        border: 1px solid #e2e8f0;
        color: #475569;
    }

        .btn-refresh:hover {
            background: #f1f5f9;
        }

    .btn-new,
    .btn-create {
        background: #2563eb;
        color: white;
    }

        .btn-new:hover,
        .btn-create:hover {
            background: #1d4ed8;
        }

    .alert-error {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        margin-bottom: 20px;
        border-radius: 10px;
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

        .alert-error button {
            margin-left: auto;
            background: transparent;
            font-size: 22px;
            color: #991b1b;
        }

    .alert-icon {
        width: 25px;
        height: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #dc2626;
        color: white;
        font-weight: bold;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

        .stat-icon.blue {
            background: #dbeafe;
        }

        .stat-icon.green {
            background: #dcfce7;
        }

        .stat-icon.orange {
            background: #ffedd5;
        }

        .stat-icon.purple {
            background: #f3e8ff;
        }

    .stat-label {
        display: block;
        font-size: 13px;
        color: #64748b;
        margin-bottom: 4px;
    }

    .stat-card strong {
        font-size: 22px;
        color: #172033;
    }

    .search-container {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 16px;
    }

    .search-box {
        position: relative;
        flex: 1;
    }

        .search-box input {
            width: 100%;
            box-sizing: border-box;
            padding: 13px 42px;
            border: 1px solid #dbe2ea;
            border-radius: 10px;
            background: white;
            outline: none;
            font-size: 14px;
        }

            .search-box input:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 3px rgba(37,99,235,.1);
            }

    .search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 2;
    }

    .clear-search {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        color: #64748b;
        font-size: 20px;
    }

    .results-count {
        color: #64748b;
        font-size: 14px;
        white-space: nowrap;
    }

    .table-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        overflow: hidden;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .facturas-table,
    .detail-table {
        width: 100%;
        border-collapse: collapse;
    }

        .facturas-table th,
